{
  "name": "archora",
  "private": true,
  "version": "2.1.0",
  "description": "Architectural reconnaissance for large frontend codebases. Builds a dependency model, detects cycles, surfaces hot zones.",
  "author": "Archora <archora@archora.dev>",
  "license": "SEE LICENSE IN LICENSE-DESKTOP",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 6173 --strictPort",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "bench": "vite-node scripts/run-benchmarks.ts",
    "bench:scale": "vite-node scripts/run-scale-bench.ts",
    "accuracy:diff": "vite-node scripts/accuracy-diff.ts",
    "accuracy:gate": "vite-node scripts/accuracy-gate.ts",
    "calibrate:hotness": "vite-node scripts/calibrate-hotness.ts",
    "cli": "vite-node packages/cli/src/index.ts --",
    "cli:build": "npm -w @archora/cli run build",
    "cli:smoke:tarball": "node scripts/smoke-cli-tarball.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "docs:dev": "npm -w @archora/docs run dev",
    "docs:build": "npm -w @archora/docs run build",
    "docs:preview": "npm -w @archora/docs run preview",
    "license:keygen": "node scripts/license-key.mjs keygen",
    "license:issue": "node scripts/license-key.mjs issue"
  },
  "dependencies": {
    "@archora/ui": "^0.2.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "@tauri-apps/plugin-store": "^2.4.3",
    "@vue/compiler-sfc": "^3.5.39",
    "ignore": "^7.0.5",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^2.2.4",
    "vue": "^3.5.39",
    "vue-i18n": "^9.14.1",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.20.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vitest/coverage-v8": "^2.1.9",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.5.2",
    "eslint": "^9.14.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-vue": "^9.31.0",
    "happy-dom": "^20.10.6",
    "playwright": "^1.61.1",
    "postcss": "^8.5.16",
    "prettier": "^3.9.4",
    "tailwindcss": "^3.4.14",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^5.4.11",
    "vitest": "^2.1.4",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.1.10"
  }
}
