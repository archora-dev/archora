    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./analyzer": "./src/analyzer/index.ts",
    "./analyzer/sources/nodeFsFileSource": "./src/analyzer/sources/nodeFsFileSource.ts",
    "./diff": "./src/diff/index.ts",
    "./report": "./src/report/buildJsonReport.ts",
    "./config": "./src/config/frontScopeConfig.ts",
    "./cache": "./src/cache/index.ts",
